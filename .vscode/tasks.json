{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile and Run",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Compile Project",
                "Run Project"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Compile Project",
            "type": "process",
            "command": "${env:USERPROFILE}/.pico-sdk/ninja/v1.12.1/ninja.exe",
            "args": [
                "-C",
                "${workspaceFolder}/build"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Run Project",
            "type": "process",
            "command": "${env:USERPROFILE}/.pico-sdk/picotool/2.0.0/picotool/picotool.exe",
            "args": [
                "load",
                "${command:raspberry-pi-pico.launchTargetPath}",
                "-fx"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        }
    ]
}